# ===================================
# Infrastructure Manager MCP - Configuration
# ===================================
# Copiez ce fichier en .env et remplissez vos valeurs

# === PROXMOX CONFIGURATION (OBLIGATOIRE) ===
PROXMOX_HOST=192.168.1.12
PROXMOX_PORT=8006
PROXMOX_TOKEN_ID=root@pam!mcp
PROXMOX_TOKEN_SECRET=votre-token-secret-ici
PROXMOX_VERIFY_SSL=false
PROXMOX_TIMEOUT=30

# === SSH CONFIGURATION (OPTIONNEL) ===
SSH_ENABLED=true
SSH_KEY_PATH=/app/ssh_keys/id_rsa
SSH_DEFAULT_USER=root
SSH_TIMEOUT=30
SSH_PORT=22

# === MCP SERVER CONFIGURATION ===
MCP_NAME=infra-manager
MCP_VERSION=1.0.0
LOG_LEVEL=INFO
MCP_LOG_FILE=/var/log/infra-manager-mcp.log

# === MODE SERVEUR (OPTIONNEL) ===
# Pour connexion distante, décommenter et configurer :
# MCP_MODE=server
# MCP_HOST=0.0.0.0
# MCP_PORT=8080
